  const buttons = items.map(a => [Markup.button.callback(`#${a.id} ${a.fish.emoji} ${a.fish.name} — ${a.price}⭐`, `bid_${a.id}`)]);
  buttons.push([Markup.button.callback(t(uid, 'back'), 'back_main')]);
