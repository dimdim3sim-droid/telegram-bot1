  await ctx.answerCbQuery();
  const uid = ctx.from.id;
  const newLang = getLang(uid) === 'ru' ? 'en' : 'ru';
  setLang(uid, newLang);
  await editMsg(ctx, menuText(uid), mainMenu(uid));
});
